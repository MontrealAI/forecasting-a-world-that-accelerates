{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://montreal.ai/schemas/fwaa/v2/registry-record.schema.json",
  "title": "FWAA forecast registry record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_version",
    "forecast_id",
    "research_cutoff",
    "target",
    "input_sha256",
    "forecast_sha256",
    "previous_record_sha256",
    "registered_at",
    "status",
    "score",
    "record_sha256"
  ],
  "properties": {
    "registry_version": {
      "const": "2.0.0"
    },
    "forecast_id": {
      "type": "string"
    },
    "research_cutoff": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}(T.*)?$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "metric",
        "unit",
        "scope",
        "horizon_end",
        "target_kind"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 8
        },
        "metric": {
          "type": "string",
          "minLength": 2
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 2
        },
        "horizon_end": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}(T.*)?$"
        },
        "target_kind": {
          "enum": [
            "stock",
            "flow",
            "probability",
            "threshold",
            "completion_date",
            "adoption_fraction",
            "revenue",
            "technical_capability",
            "other"
          ]
        },
        "success_definition": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "higher_is_better",
            "lower_is_better"
          ]
        }
      }
    },
    "forecast_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "previous_record_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "registered_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}(T.*)?$"
    },
    "status": {
      "enum": [
        "prospective-unscored",
        "demonstration-unscored",
        "matured-scored",
        "superseded"
      ]
    },
    "score": {
      "type": [
        "object",
        "null"
      ]
    },
    "record_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
