{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MontrealAI/forecasting-a-world-that-accelerates/blob/v2.0.0/protocol/task-graph.schema.json",
  "title": "Verified Workflow Task Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["tasks"],
  "properties": {
    "time_unit": {"type": "string", "default": "hours"},
    "cost_unit": {"type": "string", "default": "normalized"},
    "parallel_workers": {"type": "integer", "minimum": 1, "default": 1},
    "parallel_efficiency": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 1},
    "coordination_coefficient": {"type": "number", "minimum": 0, "default": 0},
    "correlated_failure_penalty": {"type": "number", "minimum": 0, "default": 0},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "success_probability", "max_attempts", "ai_time", "verification_time"],
        "properties": {
          "task_id": {"type": "string", "minLength": 1},
          "success_probability": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
          "max_attempts": {"type": "integer", "minimum": 1},
          "ai_time": {"type": "number", "minimum": 0},
          "verification_time": {"type": "number", "minimum": 0},
          "human_fallback_time": {"type": "number", "minimum": 0, "default": 0},
          "authority_latency": {"type": "number", "minimum": 0, "default": 0},
          "external_latency": {"type": "number", "minimum": 0, "default": 0},
          "ai_cost": {"type": "number", "minimum": 0, "default": 0},
          "verification_cost": {"type": "number", "minimum": 0, "default": 0},
          "human_fallback_cost": {"type": "number", "minimum": 0, "default": 0},
          "per_attempt_reliability": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1},
          "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "correlated_group": {"type": ["string", "null"]}
        }
      }
    }
  }
}
