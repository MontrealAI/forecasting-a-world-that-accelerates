            attempts.append({"provider": url, "status": "ok", "block_hash": block.hash.hex()})
            return w3, url, attempts
        except Exception as exc:
            attempts.append({"provider": url, "status": "error", "error": str(exc)})
    raise RuntimeError(f"No usable Web3 provider: {attempts}")


def query_balances(w3: Web3, candidates: list[str], token_ids: list[int], block_number: int,
                   chunk_size: int = 1000) -> dict[tuple[str, int], int]:
    contract = w3.eth.contract(address=CONTRACT, abi=BALANCE_OF_BATCH_ABI)
    pairs = [(address, token_id) for address in candidates for token_id in token_ids]
    result: dict[tuple[str, int], int] = {}

    def call_chunk(chunk: list[tuple[str, int]]) -> None:
        accounts = [Web3.to_checksum_address(address) for address, _ in chunk]
        ids = [token_id for _, token_id in chunk]
        try:
            values = contract.functions.balanceOfBatch(accounts, ids).call(block_identifier=block_number)
        except Exception:
            if len(chunk) <= 100:
                raise
            middle = len(chunk) // 2
            call_chunk(chunk[:middle])
            call_chunk(chunk[middle:])
            return
        if len(values) != len(chunk):
            raise RuntimeError(f"balanceOfBatch returned {len(values)} values for {len(chunk)} pairs")
        for (address, token_id), value in zip(chunk, values):
            result[(address.lower(), token_id)] = int(value)

    total_chunks = (len(pairs) + chunk_size - 1) // chunk_size
    for chunk_no, start in enumerate(range(0, len(pairs), chunk_size), 1):
        call_chunk(pairs[start:start + chunk_size])
        if chunk_no == 1 or chunk_no % 10 == 0 or chunk_no == total_chunks:
            print(f"Onchain balance matrix: chunk {chunk_no}/{total_chunks}", flush=True)
    return result


def get_nft_owners(session: requests.Session, key: str, token_id: int) -> list[str]:
    owners: set[str] = set()

    # Public item-page fallback: no key or account required. Every address found is only
    # a candidate; the historical ERC-1155 balance call below decides actual ownership.
    item_url = f"https://opensea.io/item/{CHAIN}/{CONTRACT}/{token_id}"
    try:
        html_text = request_text(session, item_url, attempts=2, timeout=20)
        for raw_address in RAW_ADDRESS_RE.findall(html_text):
            try:
                address = Web3.to_checksum_address(raw_address)
                if address.lower() not in (ZERO, CONTRACT.lower()):
                    owners.add(address)
            except Exception:
                pass
    except Exception as exc:
        print(f"Public item owner discovery failed for {token_id}: {exc}", flush=True)

    if key:
        headers = {"x-api-key": key, "accept": "application/json", "user-agent": "MONTREAL.AI-Becoming-Snapshot/1.0"}
        url = f"https://api.opensea.io/api/v2/chain/{CHAIN}/contract/{CONTRACT}/nfts/{token_id}/owners"
        cursor: str | None = None
        try:
            for _ in range(20):
                params: dict[str, Any] = {"limit": 50}
                if cursor:
                    params["next"] = cursor
                data = request_json(session, "GET", url, headers=headers, params=params, attempts=2, timeout=20)
                entries = data.get("owners") or data.get("holders") or []
                owners |= collect_addresses(entries)
                for raw_address in RAW_ADDRESS_RE.findall(json.dumps(entries)):
                    owners.add(Web3.to_checksum_address(raw_address))
                cursor_val = data.get("next") or data.get("next_cursor")
                if isinstance(cursor_val, dict):
                    cursor_val = cursor_val.get("value")
                cursor = str(cursor_val) if cursor_val else None
                if not cursor:
                    break
                time.sleep(0.2)
        except Exception as exc:
            print(f"OpenSea API owner fallback failed for {token_id}: {exc}", flush=True)

    return sorted(owners, key=str.lower)


def get_code_types(w3: Web3, addresses: list[str], block_number: int) -> dict[str, str]:
    out: dict[str, str] = {}
    for i, address in enumerate(addresses, 1):
        try:
            code = w3.eth.get_code(Web3.to_checksum_address(address), block_identifier=block_number)
            out[address.lower()] = "contract" if len(code) > 0 else "eoa"
        except Exception:
            out[address.lower()] = "unknown"
        if i % 50 == 0 or i == len(addresses):
            print(f"Wallet classification: {i}/{len(addresses)}", flush=True)
    return out


def write_csv(path: Path, rows: list[dict[str, Any]], fieldnames: list[str]) -> None:
    with path.open("w", encoding="utf-8", newline="") as fh:
        writer = csv.DictWriter(fh, fieldnames=fieldnames, extrasaction="ignore")
        writer.writeheader()
        writer.writerows(rows)


