        "raw_nft_records": len(raw_nfts),
        "accepted_unique_records": len(records),
        "rejected_records": len(rejected),
        "rejected": rejected,
        "title_numbers_form_exact_1_to_556_sequence": names_form_complete_sequence,
        "title_number_missing_count": sum(n is None for n in numbers),
        "title_number_duplicate_count": len([n for n in number_set if numbers.count(n) > 1]),
    }
    return records, audit


def rpc_call(session: requests.Session, url: str, method: str, params: list[Any], request_id: int = 1) -> Any:
    payload = {"jsonrpc": "2.0", "id": request_id, "method": method, "params": params}
    data = request_json(session, "POST", url, json_body=payload, attempts=2, timeout=12)
    if "error" in data:
        raise RuntimeError(f"RPC {method} error at {url}: {data['error']}")
    return data.get("result")


def determine_finalized_block(session: requests.Session) -> dict[str, Any]:
    observations: list[dict[str, Any]] = []
    verification: list[dict[str, Any]] = []
    selected: dict[str, Any] | None = None
    selected_provider: str | None = None
    corroborated = False

    for url in RPC_URLS:
        try:
            if selected is None:
                block = rpc_call(session, url, "eth_getBlockByNumber", ["finalized", False])
                if not isinstance(block, dict) or not block.get("number") or not block.get("hash"):
                    raise RuntimeError(f"Malformed finalized block: {block}")
                selected = block
                selected_provider = url
                observations.append({
                    "provider": url,
                    "number": int(block["number"], 16),
                    "hash": block["hash"],
                    "timestamp": int(block["timestamp"], 16),
                    "status": "selected",
                })
                continue

            number = int(selected["number"], 16)
            block = rpc_call(session, url, "eth_getBlockByNumber", [hex(number), False])
            got_hash = block.get("hash") if isinstance(block, dict) else None
            match = isinstance(got_hash, str) and got_hash.lower() == str(selected["hash"]).lower()
            verification.append({
                "provider": url,
                "number": number,
                "hash": got_hash,
                "matches_selected_hash": match,
            })
            if match:
                corroborated = True
                break
        except Exception as exc:
            target = observations if selected is None else verification
            target.append({"provider": url, "status": "error", "error": str(exc)})

    if selected is None or selected_provider is None:
        raise RuntimeError(f"No RPC endpoint returned a finalized block: {observations}")
    if not corroborated:
        raise RuntimeError(f"Finalized block was not independently corroborated: {verification}")

    number = int(selected["number"], 16)
    block_hash = str(selected["hash"])
    timestamp = int(selected["timestamp"], 16)
    return {
        "chain": CHAIN,
        "chain_id": CHAIN_ID,
        "block_number": number,
        "block_number_hex": hex(number),
        "block_hash": block_hash,
        "block_timestamp_unix": timestamp,
        "block_timestamp_utc": datetime.fromtimestamp(timestamp, timezone.utc).isoformat().replace("+00:00", "Z"),
        "selection_rule": "Ethereum JSON-RPC finalized block at execution time, independently corroborated",
        "selected_provider": selected_provider,
        "finalized_observations": observations,
        "block_hash_verification": verification,
        "captured_at_utc": utc_now(),
    }


