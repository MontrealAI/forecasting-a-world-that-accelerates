def utc_now() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def write_json(path: Path, value: Any) -> None:
    path.write_text(json.dumps(value, indent=2, ensure_ascii=False, sort_keys=False) + "\n", encoding="utf-8")


def request_json(session: requests.Session, method: str, url: str, *, headers: dict[str, str] | None = None,
                 params: dict[str, Any] | None = None, json_body: Any = None, attempts: int = 6,
                 timeout: int = 60) -> Any:
    delay = 1.0
    last: Exception | None = None
    for attempt in range(attempts):
        try:
            response = session.request(method, url, headers=headers, params=params, json=json_body, timeout=timeout)
            if response.status_code == 429:
                wait = min(float(response.headers.get("Retry-After", delay)), 15.0)
                if attempt + 1 == attempts:
                    response.raise_for_status()
                time.sleep(max(wait, delay))
                delay = min(delay * 2, 15)
                continue
            if response.status_code in (408, 425) or response.status_code >= 500:
                response.raise_for_status()
            if 400 <= response.status_code < 500:
                response.raise_for_status()
            response.raise_for_status()
            return response.json()
        except requests.HTTPError as exc:
            last = exc
            status = exc.response.status_code if exc.response is not None else None
            retryable = status in (408, 425, 429) or (status is not None and status >= 500)
            if not retryable or attempt + 1 == attempts:
                break
            time.sleep(delay)
            delay = min(delay * 2, 15)
        except (requests.Timeout, requests.ConnectionError, ValueError) as exc:
            last = exc
            if attempt + 1 == attempts:
                break
            time.sleep(delay)
            delay = min(delay * 2, 15)
        except Exception as exc:
            last = exc
            break
    raise RuntimeError(f"Request failed after {attempt + 1} attempt(s): {method} {url}: {last}")


def request_text(session: requests.Session, url: str, *, params: dict[str, Any] | None = None,
                 attempts: int = 3, timeout: int = 25) -> str:
    headers = {
        "accept": "text/html,application/xhtml+xml,application/json;q=0.9,*/*;q=0.8",
        "accept-language": "en-US,en;q=0.9",
        "cache-control": "no-cache",
        "user-agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 Chrome/151 Safari/537.36",
    }
    delay = 1.0
    last: Exception | None = None
    for attempt in range(attempts):
        try:
            response = session.get(url, params=params, headers=headers, timeout=timeout)
            if response.status_code == 429:
                if attempt + 1 == attempts:
                    response.raise_for_status()
                time.sleep(min(float(response.headers.get("Retry-After", delay)), 10.0))
                delay = min(delay * 2, 10)
                continue
            response.raise_for_status()
            if len(response.text) < 1000:
                raise RuntimeError(f"unexpectedly short HTML response ({len(response.text)} bytes)")
            return response.text
        except Exception as exc:
            last = exc
            if attempt + 1 == attempts:
                break
            time.sleep(delay)
            delay = min(delay * 2, 10)
    raise RuntimeError(f"HTML request failed after {attempts} attempt(s): {url}: {last}")


def get_opensea_key(session: requests.Session) -> str:
    data = request_json(
        session, "POST", "https://api.opensea.io/api/v2/auth/keys",
        headers={"accept": "application/json", "content-type": "application/json"},
        json_body={}, attempts=1, timeout=10,
    )
    key = data.get("api_key")
    if not key:
        raise RuntimeError(f"OpenSea instant-key response did not contain api_key: {data}")
    return str(key)


